# unsub test configuration for scripts/e2e.sh (T-1101a, extended by T-1101g).
#
# Values only, never secrets: fake audience/caller and the local emulator. The
# script adds PORT, the discovered service URLs, `MT_E2E=1`, the per-run caller
# token and the testbed's CA file. In e2e mode (T-1101g) the process trusts
# exactly the testbed's per-run CA for its TLS one-click POST.
GOOGLE_CLOUD_PROJECT=mailtinder-e2e
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
UNSUB_AUDIENCE=mailtinder-e2e-unsub
UNSUB_TASKS_CALLER=tasks@mailtinder-e2e.iam.gserviceaccount.com
GOOGLE_OAUTH_CLIENT_ID=fake-e2e-client
