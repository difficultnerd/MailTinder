# api test configuration for scripts/e2e.sh (T-1101a).
#
# Values only, never secrets: the client id/secret are fake and the emulator
# host is loopback. Ports and the discovered service URLs are added by the
# script, which also overrides any value here for the run.
GOOGLE_CLOUD_PROJECT=mailtinder-e2e
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
MT_ENV=e2e
GOOGLE_OAUTH_CLIENT_ID=fake-e2e-client
GOOGLE_OAUTH_CLIENT_SECRET=test-only-not-a-secret
# The e2e build accepts loopback http only; never point anything at real Google.
MT_ALLOW_INSECURE_LOOPBACK=true
