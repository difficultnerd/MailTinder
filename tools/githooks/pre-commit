#!/usr/bin/env bash
# Pre-commit hook: refuse to commit a built executable, an unknown binary, a file over 1 MB or a tool/cache directory (tools/check_no_binaries.py).
# Enable in a clone with:  git config core.hooksPath tools/githooks     (the factory's worktrees also have a global hook installed by the operator)
# Fail-open if the checker itself cannot run (only exit code 1 blocks the commit). Bypass is possible with --no-verify; CI's language-policy job
# runs the same check on the whole tree, so a bypass is caught there.
root="$(git rev-parse --show-toplevel)" || exit 0
[ -f "$root/tools/check_no_binaries.py" ] || exit 0
python3 "$root/tools/check_no_binaries.py" --staged --repo "$root"
rc=$?
[ "$rc" -eq 1 ] && exit 1
exit 0
