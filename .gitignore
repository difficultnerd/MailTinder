# Rust
backend/target/
backend/lcov.info
# Coverage build debris; never commit it.
*.profraw

# Dart / Flutter
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/pubspec_overrides.yaml
app/ios/Pods/
app/android/.gradle/
app/android/local.properties
app/coverage/
# Golden-test mismatch artefacts (T-1111): the diff PNGs are never committed;
# only app/test/golden/goldens/ is tracked.
app/test/golden/failures/
# Python (tooling only)
__pycache__/
*.pyc
.venv/
# Secrets and local config
.env
.env.*
!.env.example
*.pem
# TEST-ONLY RSA keys for fake-google's OIDC fake (T-206). These are committed
# test infrastructure, never secrets; see .gitleaks.toml and
# .pre-commit-config.yaml for the matching allowlist/exclude.
!backend/crates/testkit/fixtures/keys/TEST-ONLY-*.pem
*.key
*.p12
*.jks
*.keystore
# Editors / OS
.idea/
.vscode/
.DS_Store
# Local check tooling (not committed)
tools/.bin/
tools/.venv-semgrep/
# Mutation-testing tool installed under the checkout during local runs; the
# prebuilt binary and its install metadata must never be committed (T-1112a F1).
tools/.cargo-mutants/
# Mutation-run scratch output (T-1112a F1): never commit build debris.
/target/
# Terraform provider cache and state (never commit these).
# A single Google provider binary is ~114 MB and GitHub hard-rejects
# anything over 100 MB — the T-607b push died on exactly that.
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
# Terraform provider caches (114MB each) must never be committed.
# Terraform
*.tfvars
!*.tfvars.example
# Local e2e process state and synthetic service logs.
/target/
# cargo-mutants install roots (a built executable must never be committed)
tools/.cargo-mutants/
