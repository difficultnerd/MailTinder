# Rust
backend/target/
backend/lcov.info
# Coverage build debris; never commit it.
*.profraw

# Dart / Flutter
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/pubspec_overrides.yaml
app/ios/Pods/
app/android/.gradle/
app/android/local.properties
app/coverage/
# Python (tooling only)
__pycache__/
*.pyc
.venv/
# Secrets and local config
.env
.env.*
!.env.example
*.pem
# TEST-ONLY RSA keys for fake-google's OIDC fake (T-206). These are committed
# test infrastructure, never secrets; see .gitleaks.toml and
# .pre-commit-config.yaml for the matching allowlist/exclude.
!backend/crates/testkit/fixtures/keys/TEST-ONLY-*.pem
*.key
*.p12
*.jks
*.keystore
# Editors / OS
.idea/
.vscode/
.DS_Store
# Local check tooling (not committed)
tools/.bin/
tools/.venv-semgrep/
# cargo-mutants artifacts (T-1109): mutant logs hold copies of source and
# diffs, and the aarch64 fallback builds into tools/.cargo-mutants. Never
# commit either.
/target/
tools/.cargo-mutants/
# Terraform provider cache and state (never commit these).
# A single Google provider binary is ~114 MB and GitHub hard-rejects
# anything over 100 MB — the T-607b push died on exactly that.
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
# Terraform provider caches (114MB each) must never be committed.
